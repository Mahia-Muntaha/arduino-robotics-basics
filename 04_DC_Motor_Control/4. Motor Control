// DC Motor Direction and Speed Control

const int MOTOR_FORWARD = 10;
const int MOTOR_REVERSE = 11;

const int MOTOR_SPEED = 120;

void setup()
{
  pinMode(MOTOR_FORWARD, OUTPUT);
  pinMode(MOTOR_REVERSE, OUTPUT);
}

void loop()
{
  // Clockwise rotation
  analogWrite(MOTOR_FORWARD, MOTOR_SPEED);
  analogWrite(MOTOR_REVERSE, 0);
  delay(2000);

  // Stop
  analogWrite(MOTOR_FORWARD, 0);
  analogWrite(MOTOR_REVERSE, 0);
  delay(1000);

  // Counter-clockwise rotation
  analogWrite(MOTOR_FORWARD, 0);
  analogWrite(MOTOR_REVERSE, MOTOR_SPEED);
  delay(2000);

  // Stop
  analogWrite(MOTOR_FORWARD, 0);
  analogWrite(MOTOR_REVERSE, 0);
  delay(1000);
}
